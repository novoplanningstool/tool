@page "/planning"
@using Novo.Planning.Domain.Interfaces
@using Novo.Planning.Infrastructure.Import
@using Novo.Planning.Web.Features.Planning.Components
@using Novo.Planning.Web.Features.Planning.Services
@inject IPlanningService PlanningService
@inject IExcelImportService ImportService
@inject IPersonRepository PersonRepository
@inject ITaskDefinitionRepository TaskRepository
@inject IComplianceValidator ComplianceValidator
@inject IExcelExportService ExcelExportService
@inject IPlanningRepository PlanningRepository
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Planning - NOVO</PageTitle>

<h2 class="mb-2">Planning</h2>

@if (_loading)
{
    <p>Laden...</p>
}
else if (_noData)
{
    <div class="alert alert-warning">
        Geen data geladen. <a href="/">Upload eerst een Excel-bestand.</a>
    </div>
}
else
{
    <div class="d-flex gap-3">
        <!-- Settings Panel -->
        <div style="min-width: 300px; max-width: 340px; flex-shrink: 0;">
            <div class="card mb-3">
                <div class="card-header" style="background-color: #59B6AD; color: white;">Instellingen</div>
                <div class="card-body">
                    <DaySelector Label="Dag" SelectedDay="_settings.DayOfWeek" SelectedDayChanged="OnDayChanged" />

                    <div class="mb-3 mt-3">
                        <label class="form-label">Strategie</label>
                        <select class="form-select" @bind="_settings.Strategy">
                            <option value="@OptimizationStrategy.MaximizeExpertise">Iedereen doet waar hij het beste in is</option>
                            <option value="@OptimizationStrategy.LearningFocused">Zo veel mogelijk leren</option>
                            <option value="@OptimizationStrategy.Hybrid">Hybride (goede mensen op belangrijke taken)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Uitzendkrachten</label>
                        <input type="number" class="form-control" min="0"
                               value="@_settings.TempWorkerCount"
                               @oninput="OnTempWorkerCountChanged" />
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" checked="@_zeelandiaEnabled"
                               @onchange="OnZeelandiaToggled" />
                        <label class="form-check-label">Laden/lossen Zeelandia</label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Actieve taken</h6>
                        <div>
                            <button class="btn btn-link btn-sm p-0" @onclick="SelectAllTasks">Alles</button>
                            <span class="text-muted mx-1">/</span>
                            <button class="btn btn-link btn-sm p-0" @onclick="DeselectAllTasks">Geen</button>
                        </div>
                    </div>
                    <input type="text" class="form-control form-control-sm mt-1 mb-1" placeholder="Zoek taak..."
                           @bind="_taskFilter" @bind:event="oninput" />
                    <div class="mb-3 mt-1" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var task in _allTasks.Where(t => t.Name.Contains(_taskFilter, StringComparison.OrdinalIgnoreCase)
                            && t.Name != ZeelandiaTaskName))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       checked="@_selectedTaskIds.Contains(task.Id)"
                                       @onchange="e => ToggleTask(task.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label">@task.Name (@task.HeadcountRequired)</label>
                            </div>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" @onclick="Generate" disabled="@(_generating || _validating)">
                            @(_generating ? "Genereren..." : "Genereer Planning")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="GenerateRandom" disabled="@(_generating || _validating)">
                            Willekeurige planning
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Kanban Board + Compliance -->
        <div style="flex: 1; min-width: 0;">
            @if (_solverResult?.Status == SolverStatus.Infeasible)
            {
                <div class="alert alert-danger">
                    <strong>Planning kon niet worden gegenereerd.</strong>
                    @foreach (var warning in _solverResult.Warnings)
                    {
                        <p>@warning</p>
                    }
                </div>
            }

            @if (_isValidationResult && _solverResult?.Status == SolverStatus.Optimal)
            {
                @if (_violations.Count == 0)
                {
                    <div class="alert alert-success">
                        <strong>Planning is valide.</strong> Alle regels worden nageleefd.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <strong>Planning heeft aandachtspunten.</strong> Zie compliance check hieronder.
                    </div>
                }
            }

            @if (_solverResult != null && _solverResult.Status != SolverStatus.Infeasible && _solverResult.Warnings.Count > 0)
            {
                <div class="alert alert-warning">
                    @foreach (var warning in _solverResult.Warnings)
                    {
                        <p>@warning</p>
                    }
                </div>
            }

            @if (_errorMessage != null)
            {
                <div class="alert alert-danger">
                    <strong>Er is een fout opgetreden:</strong>
                    <p class="mb-0 mt-1">@_errorMessage</p>
                </div>
            }

            @if (_generating || _validating)
            {
                <div class="d-flex align-items-center gap-2 my-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span>@(_validating ? "Planning wordt gevalideerd..." : "Planning wordt gegenereerd...")</span>
                </div>
            }

            @if (_planning != null)
            {
                <div class="mb-3 d-flex align-items-center gap-2">
                    <button class="btn btn-info text-white" @onclick="Validate" disabled="@(_generating || _validating || !HasAssignments)">
                        @(_validating ? "Valideren..." : "Valideer")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ExportExcel" disabled="@(_generating || _validating || !HasAssignments)">Exporteer Excel</button>
                    <button class="btn btn-outline-warning" @onclick="ResetBoard">Iedereen loskoppelen</button>
                    <button class="btn btn-outline-danger" @onclick="Unload">Ander bestand laden</button>
                </div>

                <KanbanBoard Planning="_planning" AllPersons="AllPersonsIncludingTemp" AllTasks="_allTasks"
                             SelectedTaskIds="_selectedTaskIds"
                             DayOffWorkerNames="_dayOffWorkerNames"
                             TempWorkers="_tempWorkers"
                             Violations="_violations"
                             HighlightedTaskName="@_highlightedTaskName"
                             OnHighlightChanged="OnHighlightChanged"
                             OnAssignmentChanged="OnAssignmentChanged"
                             OnTaskRemoved="OnTaskRemovedFromBoard"
                             OnTaskMoved="OnTaskMoved"
                             OnTaskEdited="OnTaskEdited"
                             OnTempWorkerRenamed="OnTempWorkerRenamed" />

                <CompliancePanel Violations="_violations" />
            }
        </div>
    </div>
}

@code {
    private const string ZeelandiaTaskName = WellKnownIds.ZeelandiaTaskName;

    private PlanningSettings _settings = new();
    private List<Person> _allPersons = [];
    private List<TaskDefinition> _allTasks = [];
    private HashSet<string> _selectedWorkerIds = [];
    private HashSet<string> _selectedTaskIds = [];
    private SolverResult? _solverResult;
    private PlanningModel? _planning;
    private List<ComplianceViolation> _violations = [];
    private bool _loading = true;
    private bool _generating;
    private bool _validating;
    private bool _isValidationResult;
    private string? _errorMessage;
    private string _taskFilter = "";
    private bool _noData;

    // Zeelandia special task
    private TaskDefinition? _zeelandiaTask;
    private bool _zeelandiaEnabled = true;
    private HashSet<string> _dayOffWorkerNames = [];

    // Temp workers
    private List<Person> _tempWorkers = [];
    private List<Person> AllPersonsIncludingTemp => [.._allPersons, .._tempWorkers];

    private bool HasAssignments => _planning?.Assignments.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _allPersons = (await PersonRepository.GetAllAsync()).ToList();
        _allTasks = (await TaskRepository.GetAllAsync()).ToList();

        if (_allPersons.Count == 0)
        {
            _noData = true;
            _loading = false;
            return;
        }

        // Detect or create Zeelandia task
        _zeelandiaTask = _allTasks.FirstOrDefault(t => t.Name == ZeelandiaTaskName);
        if (_zeelandiaTask == null)
        {
            _zeelandiaTask = new TaskDefinition
            {
                Name = ZeelandiaTaskName,
                IsActive = false,
                HeadcountRequired = 2,
                BoardPosition = BoardPosition.Left,
                SortOrder = 0 // first on the left board
            };
            await TaskRepository.UpsertAsync(_zeelandiaTask);
            _allTasks.Insert(0, _zeelandiaTask);
        }
        // Everyone can do Zeelandia — set all persons to Expert
        foreach (var person in _allPersons)
            person.Skills[ZeelandiaTaskName] = SkillLevel.Expert;

        // Restore existing planning from repository (survives navigation)
        var existing = (await PlanningRepository.GetAllAsync()).FirstOrDefault();
        if (existing != null)
        {
            _planning = existing;
            _settings.TempWorkerCount = existing.TempWorkerCount;
            RegenerateTempWorkers();
            // Restore selected tasks from assignments on the board
            var taskNamesOnBoard = existing.Assignments.Select(a => a.TaskName).ToHashSet();
            _selectedTaskIds = _allTasks
                .Where(t => t.IsActive || taskNamesOnBoard.Contains(t.Name))
                .Select(t => t.Id)
                .ToHashSet();
            _selectedTaskIds.Add(_zeelandiaTask.Id);
            // Restore worker selection from absent workers
            var absentNames = existing.AbsentWorkers.ToHashSet();
            _selectedWorkerIds = _allPersons
                .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !absentNames.Contains(p.Name))
                .Select(p => p.Id)
                .ToHashSet();
            _dayOffWorkerNames = _allPersons
                .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && p.DefaultDaysOff.Contains(_settings.DayOfWeek))
                .Select(p => p.Name)
                .ToHashSet();
            RunComplianceCheck();
        }
        else
        {
            // Fresh session — default selection
            _settings.DayOfWeek = DateTime.Today.DayOfWeek;
            UpdateWorkerSelection();
            RegenerateTempWorkers();
            _selectedTaskIds = _allTasks.Where(t => t.IsActive).Select(t => t.Id).ToHashSet();
            _selectedTaskIds.Add(_zeelandiaTask.Id);
            _planning = CreateEmptyPlanning();
        }

        _loading = false;
    }

    private PlanningModel CreateEmptyPlanning()
    {
        return new PlanningModel
        {
            DayName = DaySelector.ToDutchName(_settings.DayOfWeek),
            Strategy = _settings.Strategy,
            TempWorkerCount = _settings.TempWorkerCount,
            Assignments = [],
            AbsentWorkers = _allPersons
                .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !_selectedWorkerIds.Contains(p.Id))
                .Select(p => p.Name)
                .ToList(),
        };
    }

    private void OnDayChanged(DayOfWeek day)
    {
        _settings.DayOfWeek = day;
        if (_planning != null)
            _planning.DayName = DaySelector.ToDutchName(day);
        UpdateWorkerSelection();
        SyncAbsentWorkers();
    }

    private void UpdateWorkerSelection()
    {
        _selectedWorkerIds = _allPersons
            .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !p.DefaultDaysOff.Contains(_settings.DayOfWeek))
            .Select(p => p.Id)
            .ToHashSet();
        _dayOffWorkerNames = _allPersons
            .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && p.DefaultDaysOff.Contains(_settings.DayOfWeek))
            .Select(p => p.Name)
            .ToHashSet();
    }

    private void SyncAbsentWorkers()
    {
        if (_planning == null) return;
        _planning.AbsentWorkers = _allPersons
            .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !_selectedWorkerIds.Contains(p.Id))
            .Select(p => p.Name)
            .ToList();
    }

    private void RegenerateTempWorkers()
    {
        var template = _allPersons.FirstOrDefault(p => p.Id == WellKnownIds.TempWorkerTemplateId);
        if (template == null || _settings.TempWorkerCount <= 0)
        {
            _tempWorkers = [];
            return;
        }

        var existingById = _tempWorkers.ToDictionary(p => p.Id);
        _tempWorkers = Enumerable.Range(1, _settings.TempWorkerCount)
            .Select(i =>
            {
                var id = $"{WellKnownIds.TempWorkerIdPrefix}{i}";
                if (existingById.TryGetValue(id, out var existing))
                    return existing;
                return new Person
                {
                    Id = id,
                    Name = $"Uitzendkracht {i}",
                    SpeaksDutch = template.SpeaksDutch,
                    SpeaksPolish = template.SpeaksPolish,
                    DefaultDaysOff = [..template.DefaultDaysOff],
                    Skills = new Dictionary<string, SkillLevel>(template.Skills)
                };
            })
            .ToList();
    }

    private void OnTempWorkerCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var count) && count >= 0)
        {
            var oldCount = _settings.TempWorkerCount;
            var oldTempNames = _tempWorkers.Select(p => p.Name).ToHashSet();
            _settings.TempWorkerCount = count;
            RegenerateTempWorkers();

            // Remove assignments for temp workers that no longer exist
            if (count < oldCount && _planning != null)
            {
                var validTempNames = _tempWorkers.Select(p => p.Name).ToHashSet();
                _planning.Assignments.RemoveAll(a =>
                    oldTempNames.Contains(a.WorkerName) && !validTempNames.Contains(a.WorkerName));
                _planning.TempWorkerCount = count;
                RunComplianceCheck();
            }
        }
    }

    private void OnTempWorkerRenamed((string OldName, string NewName) args)
    {
        var worker = _tempWorkers.FirstOrDefault(p => p.Name == args.OldName);
        if (worker == null) return;

        worker.Name = args.NewName;

        if (_planning != null)
        {
            foreach (var assignment in _planning.Assignments.Where(a => a.WorkerName == args.OldName))
            {
                assignment.WorkerName = args.NewName;
            }
        }
    }

    private string? _highlightedTaskName;

    private void OnHighlightChanged(string? name)
    {
        _highlightedTaskName = name;
    }

    private void OnZeelandiaToggled(ChangeEventArgs e)
    {
        _zeelandiaEnabled = (bool)(e.Value ?? false);
        if (_zeelandiaEnabled && _zeelandiaTask != null)
            _selectedTaskIds.Add(_zeelandiaTask.Id);
        else if (!_zeelandiaEnabled && _zeelandiaTask != null)
        {
            _selectedTaskIds.Remove(_zeelandiaTask.Id);
            // Remove any Zeelandia assignments from the board
            if (_planning != null)
                _planning.Assignments = _planning.Assignments
                    .Where(a => a.TaskName != ZeelandiaTaskName).ToList();
        }
    }

    private List<PlanningAssignment> GetZeelandiaAssignments()
    {
        if (!_zeelandiaEnabled || _planning == null) return [];
        return _planning.Assignments.Where(a => a.TaskName == ZeelandiaTaskName).ToList();
    }

    private void ExcludeZeelandiaFromSolverSettings(List<PlanningAssignment> zeelandiaAssignments)
    {
        if (!_zeelandiaEnabled || _zeelandiaTask == null) return;

        // Remove Zeelandia task from solver
        _settings.ActiveTaskIds = _settings.ActiveTaskIds
            .Where(id => id != _zeelandiaTask.Id)
            .ToList();

        // Remove Zeelandia workers from solver pool
        var zeelandiaWorkerNames = zeelandiaAssignments.Select(a => a.WorkerName).ToHashSet();
        var zeelandiaWorkerIds = _allPersons
            .Where(p => zeelandiaWorkerNames.Contains(p.Name))
            .Select(p => p.Id)
            .ToHashSet();
        _settings.PresentWorkerIds = _settings.PresentWorkerIds
            .Where(id => !zeelandiaWorkerIds.Contains(id))
            .ToList();
    }

    private (List<CustomTask> Tasks, List<PlanningAssignment> Assignments, HashSet<string> WorkerNames) GetPreservedCustomTaskData()
    {
        var tasks = _planning?.CustomTasks ?? [];
        var taskNames = tasks.Select(ct => ct.TaskName).ToHashSet();
        var assignments = _planning?.Assignments
            .Where(a => taskNames.Contains(a.TaskName))
            .ToList() ?? [];
        var workerNames = assignments.Select(a => a.WorkerName).ToHashSet();
        return (tasks, assignments, workerNames);
    }

    private void ToggleTask(string id, bool selected)
    {
        if (selected)
        {
            _selectedTaskIds.Add(id);
            var task = _allTasks.FirstOrDefault(t => t.Id == id);
            _highlightedTaskName = task?.Name;
        }
        else
        {
            _selectedTaskIds.Remove(id);
            var task = _allTasks.FirstOrDefault(t => t.Id == id);
            if (task?.Name == _highlightedTaskName)
                _highlightedTaskName = null;
        }
    }

    private void SelectAllTasks() =>
        _selectedTaskIds = _allTasks.Select(t => t.Id).ToHashSet();

    private void DeselectAllTasks() => _selectedTaskIds.Clear();

    private async Task Generate()
    {
        if (HasAssignments)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Het huidige bord wordt overschreven. Wil je doorgaan?");
            if (!confirmed) return;
        }

        _generating = true;
        _isValidationResult = false;
        _errorMessage = null;
        _solverResult = null;
        StateHasChanged();

        try
        {
            var absentNames = _planning?.AbsentWorkers.ToHashSet() ?? [];
            _settings.PresentWorkerIds = _allPersons
                .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !absentNames.Contains(p.Name))
                .Select(p => p.Id)
                .ToList();
            _settings.ActiveTaskIds = _selectedTaskIds.ToList();

            // Zeelandia: preserve board assignments and exclude from solver
            var zeelandiaAssignments = GetZeelandiaAssignments();
            ExcludeZeelandiaFromSolverSettings(zeelandiaAssignments);

            // Custom tasks: preserve assignments and exclude workers from solver
            var (customTasks, customTaskAssignments, customTaskWorkerNames) = GetPreservedCustomTaskData();
            var personIdToName = _allPersons.ToDictionary(p => p.Id, p => p.Name);
            _settings.PresentWorkerIds = _settings.PresentWorkerIds
                .Where(id => !customTaskWorkerNames.Contains(
                    personIdToName.GetValueOrDefault(id, "")))
                .ToList();

            // Run solver on background thread so the UI can render the spinner
            _solverResult = await Task.Run(() => PlanningService.GeneratePlanningAsync(_settings));

            if (_solverResult.Status != SolverStatus.Infeasible)
            {
                _planning = new PlanningModel
                {
                    DayName = DaySelector.ToDutchName(_settings.DayOfWeek),
                    Strategy = _settings.Strategy,
                    TempWorkerCount = _settings.TempWorkerCount,
                    Assignments = zeelandiaAssignments.Concat(customTaskAssignments).Concat(_solverResult.Assignments).ToList(),
                    CustomTasks = customTasks.ToList(),
                    Warnings = _solverResult.Warnings,
                    AbsentWorkers = absentNames.ToList(),
                };
                await PlanningService.SavePlanningAsync(_planning);
                RunComplianceCheck();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _generating = false;
            StateHasChanged();
        }
    }

    private async Task Validate()
    {
        _validating = true;
        _isValidationResult = true;
        _errorMessage = null;
        _solverResult = null;
        StateHasChanged();

        try
        {
            var absentNames = _planning?.AbsentWorkers.ToHashSet() ?? [];
            _settings.PresentWorkerIds = _allPersons
                .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !absentNames.Contains(p.Name))
                .Select(p => p.Id)
                .ToList();
            _settings.ActiveTaskIds = _selectedTaskIds.ToList();

            // Zeelandia: exclude from solver validation
            var zeelandiaAssignments = GetZeelandiaAssignments();
            ExcludeZeelandiaFromSolverSettings(zeelandiaAssignments);
            var assignmentsToValidate = _planning!.Assignments
                .Where(a => a.TaskName != ZeelandiaTaskName)
                .ToList();

            _solverResult = await Task.Run(() => PlanningService.ValidateAssignmentsAsync(_settings, assignmentsToValidate));
            RunComplianceCheck();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _validating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateRandom()
    {
        if (HasAssignments)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Het huidige bord wordt overschreven. Wil je doorgaan?");
            if (!confirmed) return;
        }

        _isValidationResult = false;
        _errorMessage = null;
        _solverResult = null;

        var absentNames = _planning?.AbsentWorkers.ToHashSet() ?? [];
        var zeelandiaAssignments = GetZeelandiaAssignments();
        var zeelandiaWorkerNames = zeelandiaAssignments.Select(a => a.WorkerName).ToHashSet();
        var (customTasks, customTaskAssignments, customTaskWorkerNames) = GetPreservedCustomTaskData();
        var excludedWorkers = zeelandiaWorkerNames.Union(customTaskWorkerNames).ToHashSet();
        var selectedTasks = _allTasks
            .Where(t => _selectedTaskIds.Contains(t.Id) &&
                        !(_zeelandiaEnabled && _zeelandiaTask != null && t.Id == _zeelandiaTask.Id))
            .ToList();
        // Regular workers first, then temp workers (prefer non-temp)
        var availableWorkers = _allPersons
            .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !absentNames.Contains(p.Name)
                        && !excludedWorkers.Contains(p.Name))
            .Concat(_tempWorkers.Where(p => !excludedWorkers.Contains(p.Name)))
            .ToList();

        var rng = new Random();
        var assignments = new List<PlanningAssignment>();
        var assigned = new HashSet<string>();

        // Build per-task candidate lists with skill levels
        var taskCandidates = new Dictionary<string, List<(Person Worker, SkillLevel Level)>>();
        foreach (var task in selectedTasks)
        {
            taskCandidates[task.Name] = availableWorkers
                .Where(w =>
                {
                    var level = w.Skills.GetValueOrDefault(task.Name, SkillLevel.Cannot);
                    return level != SkillLevel.Cannot;
                })
                .Select(w => (Worker: w, Level: w.Skills.GetValueOrDefault(task.Name, SkillLevel.Beginner)))
                .OrderBy(c => c.Worker.IsTempWorker ? 1 : 0) // prefer regular workers
                .ThenBy(_ => rng.Next())
                .ToList();
        }

        // Pass 1: fill required skill minimums (Level1 experts first, then Level2, Level3)
        foreach (var task in selectedTasks)
        {
            var candidates = taskCandidates[task.Name];
            var taskAssigned = new List<(Person Worker, SkillLevel Level)>();

            // Fill MinWorkersLevel1 (Expert)
            FillSlots(candidates, taskAssigned, assigned, task.MinWorkersLevel1,
                c => c.Level == SkillLevel.Expert);

            // Fill MinWorkersLevel2 (Expert or Experienced)
            var level2Have = taskAssigned.Count(a => a.Level <= SkillLevel.Experienced);
            FillSlots(candidates, taskAssigned, assigned, task.MinWorkersLevel2 - level2Have,
                c => c.Level <= SkillLevel.Experienced);

            // Fill MinWorkersLevel3 (Expert, Experienced or Beginner)
            var level3Have = taskAssigned.Count(a => a.Level <= SkillLevel.Beginner);
            FillSlots(candidates, taskAssigned, assigned, task.MinWorkersLevel3 - level3Have,
                c => c.Level <= SkillLevel.Beginner);

            // Fill remaining headcount with any eligible worker, prefer better skills
            var remaining = task.HeadcountRequired - taskAssigned.Count;
            if (remaining > 0)
            {
                var rest = candidates
                    .Where(c => !assigned.Contains(c.Worker.Name))
                    .OrderBy(c => (int)c.Level)
                    .ThenBy(c => c.Worker.IsTempWorker ? 1 : 0)
                    .ThenBy(_ => rng.Next())
                    .Take(remaining);
                foreach (var c in rest)
                {
                    taskAssigned.Add(c);
                    assigned.Add(c.Worker.Name);
                }
            }

            // Language collaboration: if required, try to ensure shared language
            if (task.RequiresLanguageCollaboration && taskAssigned.Count >= 2)
            {
                var hasDutch = taskAssigned.Any(a => a.Worker.SpeaksDutch);
                var hasPolish = taskAssigned.Any(a => a.Worker.SpeaksPolish);
                var allShareLanguage = taskAssigned.All(a => a.Worker.SpeaksDutch) ||
                                       taskAssigned.All(a => a.Worker.SpeaksPolish);

                if (!allShareLanguage)
                {
                    // Try to swap out the odd-language worker for one that matches
                    var majorityDutch = taskAssigned.Count(a => a.Worker.SpeaksDutch) >=
                                        taskAssigned.Count(a => a.Worker.SpeaksPolish);
                    var targetLang = majorityDutch;

                    for (int i = 0; i < taskAssigned.Count; i++)
                    {
                        var w = taskAssigned[i];
                        var matches = targetLang ? w.Worker.SpeaksDutch : w.Worker.SpeaksPolish;
                        if (matches) continue;

                        // Find a swap candidate
                        var swap = candidates
                            .Where(c => !assigned.Contains(c.Worker.Name) &&
                                        (targetLang ? c.Worker.SpeaksDutch : c.Worker.SpeaksPolish))
                            .OrderBy(c => (int)c.Level)
                            .ThenBy(c => c.Worker.IsTempWorker ? 1 : 0)
                            .FirstOrDefault();
                        if (swap.Worker != null)
                        {
                            assigned.Remove(w.Worker.Name);
                            assigned.Add(swap.Worker.Name);
                            taskAssigned[i] = swap;
                        }
                    }
                }
            }

            foreach (var (worker, level) in taskAssigned)
            {
                assignments.Add(new PlanningAssignment
                {
                    TaskName = task.Name,
                    WorkerName = worker.Name,
                    SkillLevel = level
                });
            }
        }

        _planning = new PlanningModel
        {
            DayName = DaySelector.ToDutchName(_settings.DayOfWeek),
            Strategy = _settings.Strategy,
            TempWorkerCount = _settings.TempWorkerCount,
            Assignments = zeelandiaAssignments.Concat(customTaskAssignments).Concat(assignments).ToList(),
            CustomTasks = customTasks.ToList(),
            AbsentWorkers = absentNames.ToList(),
        };

        RunComplianceCheck();
    }

    private static void FillSlots(
        List<(Person Worker, SkillLevel Level)> candidates,
        List<(Person Worker, SkillLevel Level)> taskAssigned,
        HashSet<string> assigned,
        int needed,
        Func<(Person Worker, SkillLevel Level), bool> filter)
    {
        if (needed <= 0) return;
        var picks = candidates
            .Where(c => !assigned.Contains(c.Worker.Name) && filter(c))
            .Take(needed);
        foreach (var pick in picks)
        {
            taskAssigned.Add(pick);
            assigned.Add(pick.Worker.Name);
        }
    }

    private async Task ResetBoard()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Weet je zeker dat je alle toewijzingen wilt verwijderen?");
        if (!confirmed) return;

        _solverResult = null;
        _isValidationResult = false;
        _errorMessage = null;
        _violations = [];
        UpdateWorkerSelection();
        _planning = CreateEmptyPlanning();
        await PlanningRepository.UpsertAsync(_planning);
        RunComplianceCheck();
    }

    private async Task Unload()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Weet je zeker dat je de data wilt wissen en een ander bestand wilt laden?");
        if (!confirmed) return;

        await ImportService.UnloadAsync();
        Navigation.NavigateTo("/");
    }

    private bool HasIssues => _violations.Count > 0 || (_solverResult?.Warnings.Count > 0);

    private async Task ExportExcel()
    {
        if (_planning == null) return;

        RunComplianceCheck();
        StateHasChanged();

        if (HasIssues)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "De planning heeft aandachtspunten. Toch exporteren?");
            if (!confirmed) return;
        }

        var bytes = ExcelExportService.Export(_planning);
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("novoExport.downloadFile", "planning.xlsx", base64);
    }

    private void OnTaskRemovedFromBoard(string taskId)
    {
        _selectedTaskIds.Remove(taskId);
        if (_zeelandiaTask != null && taskId == _zeelandiaTask.Id)
            _zeelandiaEnabled = false;
        RunComplianceCheck();
        StateHasChanged();
    }

    private async Task OnAssignmentChanged()
    {
        if (_planning != null)
            await PlanningRepository.UpsertAsync(_planning);
        RunComplianceCheck();
        StateHasChanged();
    }

    private async Task OnTaskMoved(TaskDefinition task)
    {
        await TaskRepository.UpsertAsync(task);
        StateHasChanged();
    }

    private async Task OnTaskEdited(TaskDefinition task)
    {
        // Persist regular task changes (custom tasks are in-memory only)
        if (_allTasks.Any(t => t.Id == task.Id))
            await TaskRepository.UpsertAsync(task);
        if (_planning != null)
            await PlanningRepository.UpsertAsync(_planning);
        RunComplianceCheck();
        StateHasChanged();
    }

    private void RunComplianceCheck()
    {
        if (_planning != null)
        {
            var boardTasks = _allTasks.Where(t => _selectedTaskIds.Contains(t.Id)).ToList();
            boardTasks.AddRange(_planning.CustomTasks.Select(ct => ct.ToTaskDefinition()));
            _violations = ComplianceValidator.Validate(_planning, AllPersonsIncludingTemp, boardTasks);
        }
    }
}
