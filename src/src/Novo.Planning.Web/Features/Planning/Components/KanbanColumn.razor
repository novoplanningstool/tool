@{
    var skillCounts = GetSkillCounts();
    var statusClass = GetStatusClass(skillCounts);
    var headcountMet = TaskDef != null && Assignments.Count >= TaskDef.HeadcountRequired;
    var experts = skillCounts.GetValueOrDefault(SkillLevel.Expert);
    var experienced = skillCounts.GetValueOrDefault(SkillLevel.Experienced);
    var beginners = skillCounts.GetValueOrDefault(SkillLevel.Beginner);
}
<div class="task-row @statusClass"
     data-drop-task="@TaskName"
     @onclick:stopPropagation="true">
    <div class="task-row-name @(IsHighlighted ? "highlighted" : "")"
         draggable="true"
         data-drag-column="@TaskName"
         @onclick="OnHeaderClick">
        <span class="drag-handle">&#9776;</span>
        <strong class="task-row-label">@TaskName</strong>
    </div>
    <div class="task-row-workers">
        @foreach (var assignment in Assignments)
        {
            <KanbanCard Assignment="assignment" AllPersons="AllPersons" HighlightedTaskName="@HighlightedTaskName"
                        OnRemove="@(() => OnWorkerRemoved.InvokeAsync(assignment.WorkerName))"
                        OnTempWorkerRenamed="OnTempWorkerRenamed" />
        }
    </div>
    <div class="task-row-status">
        @if (TaskDef != null)
        {
            <span class="status-count @(headcountMet ? "met" : "unmet")"
                  title="@Assignments.Count van @TaskDef.HeadcountRequired mensen">
                @Assignments.Count/@TaskDef.HeadcountRequired
                @(headcountMet ? "✓" : "")
            </span>
            @if (TaskDef.MinWorkersLevel1 > 0)
            {
                var met = experts >= TaskDef.MinWorkersLevel1;
                <span class="slot-badge @(met ? "slot-ok" : "slot-needed")"
                      title="Min. @TaskDef.MinWorkersLevel1 Expert vereist">
                    E:@experts/@TaskDef.MinWorkersLevel1
                </span>
            }
            @if (TaskDef.MinWorkersLevel2 > 0)
            {
                var level2Have = experts + experienced;
                var met = level2Have >= TaskDef.MinWorkersLevel2;
                <span class="slot-badge @(met ? "slot-ok" : "slot-needed")"
                      title="Min. @TaskDef.MinWorkersLevel2 Ervaren+ vereist">
                    V:@level2Have/@TaskDef.MinWorkersLevel2
                </span>
            }
            @if (TaskDef.MinWorkersLevel3 > 0)
            {
                var level3Have = experts + experienced + beginners;
                var met = level3Have >= TaskDef.MinWorkersLevel3;
                <span class="slot-badge @(met ? "slot-ok" : "slot-needed")"
                      title="Min. @TaskDef.MinWorkersLevel3 Beginner+ vereist">
                    B:@level3Have/@TaskDef.MinWorkersLevel3
                </span>
            }
        }
        <span class="task-row-actions">
            @if (Assignments.Count > 0 && OnClearAll.HasDelegate)
            {
                <button class="row-action-btn" @onclick="OnClearAll" @onclick:stopPropagation="true"
                        title="Alle medewerkers loskoppelen">Leeg</button>
            }
            @if (OnTaskEdited.HasDelegate)
            {
                <button class="row-action-btn" @onclick="ToggleEdit" @onclick:stopPropagation="true"
                        title="Taak bewerken">&#9998;</button>
            }
            @if (OnRemove.HasDelegate)
            {
                <button class="row-action-btn remove" @onclick="OnRemove" @onclick:stopPropagation="true"
                        title="Verwijder van bord">&#215;</button>
            }
        </span>
    </div>
    @if (IsEditing && TaskDef != null)
    {
        <div class="task-edit-popover" @onclick:stopPropagation="true">
            <div class="mb-1">
                <label>Aantal mensen</label>
                <input type="number" min="1" max="20" @bind="_editHeadcount" class="form-control form-control-sm" />
            </div>
            @if (!HeadcountOnly)
            {
                <div class="mb-1">
                    <label>Min. Expert</label>
                    <input type="number" min="0" @bind="_editLevel1" class="form-control form-control-sm" />
                </div>
                <div class="mb-1">
                    <label>Min. Ervaren+</label>
                    <input type="number" min="0" @bind="_editLevel2" class="form-control form-control-sm" />
                </div>
                <div class="mb-1">
                    <label>Min. Beginner+</label>
                    <input type="number" min="0" @bind="_editLevel3" class="form-control form-control-sm" />
                </div>
            }
            <button class="btn btn-sm btn-primary mt-1" @onclick="SaveEdit">Opslaan</button>
        </div>
    }
</div>

@code {
    [Parameter] public string TaskName { get; set; } = "";
    [Parameter] public List<PlanningAssignment> Assignments { get; set; } = [];
    [Parameter] public TaskDefinition? TaskDef { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnHeaderClick { get; set; }
    [Parameter] public string? HighlightedTaskName { get; set; }
    [Parameter] public List<Person> AllPersons { get; set; } = [];
    [Parameter] public List<ComplianceViolation> Violations { get; set; } = [];
    [Parameter] public EventCallback<string> OnWorkerRemoved { get; set; }
    [Parameter] public EventCallback OnClearAll { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback<string?> OnEditToggle { get; set; }
    [Parameter] public EventCallback<TaskDefinition> OnTaskEdited { get; set; }
    [Parameter] public bool HeadcountOnly { get; set; }
    [Parameter] public EventCallback<(string OldName, string NewName)> OnTempWorkerRenamed { get; set; }

    private int _editHeadcount;
    private int _editLevel1Backing;
    private int _editLevel2Backing;
    private int _editLevel3Backing;
    private bool _wasEditing;

    private int _editLevel1
    {
        get => _editLevel1Backing;
        set => SetEditLevel(ref _editLevel1Backing, value);
    }
    private int _editLevel2
    {
        get => _editLevel2Backing;
        set => SetEditLevel(ref _editLevel2Backing, value);
    }
    private int _editLevel3
    {
        get => _editLevel3Backing;
        set => SetEditLevel(ref _editLevel3Backing, value);
    }

    private void SetEditLevel(ref int backing, int value)
    {
        var clamped = Math.Max(0, value);
        var delta = clamped - backing;
        backing = clamped;
        _editHeadcount = Math.Max(1, _editHeadcount + delta);
    }

    private bool IsHighlighted => HighlightedTaskName == TaskName;

    protected override void OnParametersSet()
    {
        if (IsEditing && !_wasEditing && TaskDef != null)
        {
            _editHeadcount = TaskDef.HeadcountRequired;
            _editLevel1Backing = TaskDef.MinWorkersLevel1;
            _editLevel2Backing = TaskDef.MinWorkersLevel2;
            _editLevel3Backing = TaskDef.MinWorkersLevel3;
        }
        _wasEditing = IsEditing;
    }

    private async Task ToggleEdit()
    {
        await OnEditToggle.InvokeAsync(IsEditing ? null : TaskName);
    }

    private async Task SaveEdit()
    {
        if (TaskDef == null) return;
        TaskDef.HeadcountRequired = Math.Max(1, _editHeadcount);
        TaskDef.MinWorkersLevel1 = Math.Max(0, _editLevel1);
        TaskDef.MinWorkersLevel2 = Math.Max(0, _editLevel2);
        TaskDef.MinWorkersLevel3 = Math.Max(0, _editLevel3);
        await OnTaskEdited.InvokeAsync(TaskDef);
        await OnEditToggle.InvokeAsync(null);
    }

    private Dictionary<SkillLevel, int> GetSkillCounts()
    {
        return Assignments
            .GroupBy(a => a.SkillLevel)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private string GetStatusClass(Dictionary<SkillLevel, int> counts)
    {
        if (TaskDef == null) return "";

        var hasErrors = Violations.Any(v => v.Severity == ViolationSeverity.Error);
        var hasWarnings = Violations.Any(v => v.Severity == ViolationSeverity.Warning);

        var headcountMet = Assignments.Count >= TaskDef.HeadcountRequired;

        var experts = counts.GetValueOrDefault(SkillLevel.Expert);
        var experienced = counts.GetValueOrDefault(SkillLevel.Experienced);
        var beginners = counts.GetValueOrDefault(SkillLevel.Beginner);

        var skillsMet = true;
        if (TaskDef.MinWorkersLevel1 > 0 && experts < TaskDef.MinWorkersLevel1) skillsMet = false;
        if (TaskDef.MinWorkersLevel2 > 0 && (experts + experienced) < TaskDef.MinWorkersLevel2) skillsMet = false;
        if (TaskDef.MinWorkersLevel3 > 0 && (experts + experienced + beginners) < TaskDef.MinWorkersLevel3) skillsMet = false;

        if (!headcountMet || !skillsMet || hasErrors) return "status-error";
        if (hasWarnings) return "status-warning";
        return "status-ok";
    }
}
