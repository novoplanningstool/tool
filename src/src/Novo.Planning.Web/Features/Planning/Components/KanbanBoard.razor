@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="kanban-board" @onclick="ClearHighlight">
    @if (Planning != null)
    {
        _assignmentsByTask = null; // invalidate cache each render
        var allBoardTasks = GetAllBoardTasks();

        @* Pre-group violations by task name for O(1) lookup *@
        var violationsByTask = Violations
            .Where(v => v.TaskName != null)
            .GroupBy(v => v.TaskName!)
            .ToDictionary(g => g.Key, g => g.ToList());

        @* Planning progress summary *@
        var totalTasks = allBoardTasks.Count;
        var completeTasks = allBoardTasks.Count(IsTaskComplete);
        var assignedWorkers = Planning.Assignments
            .Where(a => a.TaskName != ZeelandiaTaskName)
            .Select(a => a.WorkerName).ToHashSet();
        var absentNames = Planning.AbsentWorkers.ToHashSet();
        var unassignedCount = 0;
        foreach (var p in AllPersons)
        {
            if (p.IsTempWorker || p.Id == WellKnownIds.TempWorkerTemplateId || absentNames.Contains(p.Name))
                continue;
            if (!assignedWorkers.Contains(p.Name))
                unassignedCount++;
        }
        var totalRequired = 0;
        var totalFilled = 0;
        foreach (var e in allBoardTasks)
        {
            if (e.TaskDef.Name == ZeelandiaTaskName) continue;
            totalRequired += e.TaskDef.HeadcountRequired;
            totalFilled += Math.Min(e.Assignments.Count, e.TaskDef.HeadcountRequired);
        }
        var totalMissing = totalRequired - totalFilled;
        var extraTempsNeeded = Math.Max(0, totalMissing - unassignedCount);
        var errorCount = Violations.Count(v => v.Severity == ViolationSeverity.Error);
        var warningCount = Violations.Count(v => v.Severity == ViolationSeverity.Warning);
        var problemCount = errorCount + warningCount;
        var progressClass = problemCount > 0 ? "progress-errors" : (completeTasks < totalTasks ? "progress-in-progress" : "progress-complete");

        if (totalTasks > 0)
        {
            <div class="planning-progress @progressClass mb-2 d-flex align-items-center justify-content-between">
                <span>
                    Planning: <strong>@completeTasks/@totalTasks</strong> taken compleet
                    <span class="progress-divider">|</span>
                    Bezetting: <strong class="@(totalMissing > 0 ? "staffing-short" : "staffing-full")">@totalFilled/@totalRequired</strong>
                    @if (totalMissing > 0)
                    {
                        <text> </text><span class="staffing-missing">@totalMissing tekort</span>
                    }
                    @if (unassignedCount > 0)
                    {
                        <span class="progress-divider">|</span><strong>@unassignedCount</strong><text> niet ingepland</text>
                    }
                    @if (problemCount > 0)
                    {
                        <span class="progress-divider">|</span><strong>@problemCount</strong><text> problemen</text>
                    }
                    @if (extraTempsNeeded > 0)
                    {
                        <span class="progress-divider">|</span>
                        <span class="staffing-temps-needed" title="Niet genoeg beschikbare medewerkers voor alle taken">
                            +@extraTempsNeeded uitzendkracht@(extraTempsNeeded != 1 ? "en" : "") nodig
                        </span>
                    }
                </span>
                @if (_undoSnapshot != null)
                {
                    <button class="btn btn-sm btn-outline-secondary undo-btn" @onclick="Undo" @onclick:stopPropagation="true"
                            title="Laatste actie ongedaan maken">Ongedaan maken</button>
                }
            </div>
        }

        <div class="skill-legend mb-2" @onclick:stopPropagation="true">
            <small class="me-2 text-muted">Legenda:</small>
            <span class="badge bg-success text-white me-1">Expert</span>
            <span class="badge bg-info text-dark me-1">Ervaren</span>
            <span class="badge bg-warning text-dark me-1">Beginner</span>
            <span class="badge bg-danger text-white me-1">Kan niet</span>
        </div>

        <div class="task-list">
            @{ var taskIndex = 0; }
            @foreach (var entry in allBoardTasks)
            {
                var key = entry.TaskDef.Name;
                var isCustom = entry.IsCustom;
                var taskViolations = violationsByTask.GetValueOrDefault(key, []);

                @if (entry.TaskDef.DividerAbove && taskIndex > 0)
                {
                    <div class="board-divider d-flex align-items-center my-2" @onclick:stopPropagation="true">
                        <div class="divider-line flex-grow-1"></div>
                        <button class="btn btn-sm divider-remove-btn"
                                @onclick="() => SetDivider(key, false)"
                                title="Scheidingslijn verwijderen">&times;</button>
                        <div class="divider-line flex-grow-1"></div>
                    </div>
                }
                else if (taskIndex > 0)
                {
                    <div class="divider-insert-zone" @onclick="() => SetDivider(key, true)" @onclick:stopPropagation="true"
                         title="Scheidingslijn toevoegen">
                        <span class="divider-insert-icon">+</span>
                    </div>
                }

                <KanbanColumn TaskName="@key"
                              Assignments="@entry.Assignments"
                              TaskDef="@entry.TaskDef"
                              Violations="@taskViolations"
                              OnRemove="@(isCustom ? () => ConfirmRemoveCustomTask(key) : () => ConfirmRemoveTaskFromBoard(key))"
                              OnHeaderClick="@(() => ToggleHighlight(key))"
                              OnWorkerRemoved="@(workerName => RemoveWorkerFromTask(key, workerName))"
                              OnClearAll="@(() => ClearAllFromTask(key))"
                              HighlightedTaskName="@HighlightedTaskName"
                              AllPersons="AllPersons"
                              IsEditing="@(_editingTaskName == key)"
                              OnEditToggle="ToggleEditingTask"
                              OnTaskEdited="HandleTaskEdited"
                              HeadcountOnly="@(isCustom || key == ZeelandiaTaskName)"
                              OnTempWorkerRenamed="OnTempWorkerRenamed" />

                taskIndex++;
            }
        </div>

        <div class="input-group mt-2 mb-3" style="max-width: 500px;"
             @onclick:stopPropagation="true"
             ondragover="event.preventDefault(); event.dataTransfer.dropEffect='none';"
             ondrop="event.preventDefault();">
            <input type="text" class="form-control form-control-sm"
                   placeholder="Nieuwe aangepaste taak..."
                   @bind="_newCustomTaskName"
                   @bind:event="oninput"
                   @onkeydown="HandleCustomTaskKeyDown" />
            <input type="number" class="form-control form-control-sm" style="max-width: 80px;"
                   placeholder="Aantal"
                   min="1" max="20"
                   @bind="_newCustomTaskHeadcount"
                   @bind:event="oninput"
                   title="Aantal mensen nodig" />
            <button class="btn btn-sm btn-outline-primary" @onclick="AddCustomTask"
                    disabled="@string.IsNullOrWhiteSpace(_newCustomTaskName)">
                + Taak
            </button>
        </div>

        <div class="kanban-sticky-pool" @onclick:stopPropagation="true">
            <UnassignedPool @key="@HighlightedTaskName"
                            Planning="Planning" AllPersons="AllPersons"
                            TempWorkers="TempWorkers"
                            OnMoveAllToAbsent="ConfirmMoveAllToAbsent"
                            OnMoveAllToUnplanned="MoveAllToUnplanned"
                            HighlightedTaskName="@HighlightedTaskName"
                            OnWorkerDoubleClick="AssignWorkerToHighlightedTask"
                            OnTempWorkerRenamed="OnTempWorkerRenamed" />
        </div>
    }
</div>

@code {
    [Parameter] public PlanningModel? Planning { get; set; }
    [Parameter] public List<Person> AllPersons { get; set; } = [];
    [Parameter] public List<TaskDefinition> AllTasks { get; set; } = [];
    [Parameter] public HashSet<string> SelectedTaskIds { get; set; } = [];
    [Parameter] public HashSet<string> DayOffWorkerNames { get; set; } = [];
    [Parameter] public List<ComplianceViolation> Violations { get; set; } = [];
    [Parameter] public EventCallback OnAssignmentChanged { get; set; }
    [Parameter] public EventCallback<string> OnTaskRemoved { get; set; }
    [Parameter] public EventCallback<TaskDefinition> OnTaskMoved { get; set; }
    [Parameter] public EventCallback<TaskDefinition> OnTaskEdited { get; set; }
    [Parameter] public string? HighlightedTaskName { get; set; }
    [Parameter] public EventCallback<string?> OnHighlightChanged { get; set; }
    [Parameter] public List<Person> TempWorkers { get; set; } = [];
    [Parameter] public EventCallback<(string OldName, string NewName)> OnTempWorkerRenamed { get; set; }

    private const string ZeelandiaTaskName = WellKnownIds.ZeelandiaTaskName;
    private string _newCustomTaskName = "";
    private int _newCustomTaskHeadcount = 2;
    private string? _editingTaskName;
    private DotNetObjectReference<KanbanBoard>? _dotNetRef;

    private void ToggleEditingTask(string? name)
    {
        _editingTaskName = _editingTaskName == name ? null : name;
    }

    // Undo state (#7)
    private record UndoSnapshot(List<PlanningAssignment> Assignments, List<string> AbsentWorkers);
    private UndoSnapshot? _undoSnapshot;

    private void SaveUndoSnapshot()
    {
        if (Planning == null) return;
        _undoSnapshot = new UndoSnapshot(
            Planning.Assignments.Select(a => new PlanningAssignment
            {
                TaskName = a.TaskName,
                WorkerName = a.WorkerName,
                SkillLevel = a.SkillLevel
            }).ToList(),
            new List<string>(Planning.AbsentWorkers)
        );
    }

    private async Task Undo()
    {
        if (Planning == null || _undoSnapshot == null) return;
        Planning.Assignments.Clear();
        Planning.Assignments.AddRange(_undoSnapshot.Assignments);
        Planning.AbsentWorkers.Clear();
        Planning.AbsentWorkers.AddRange(_undoSnapshot.AbsentWorkers);
        _undoSnapshot = null;
        await OnAssignmentChanged.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("novoDragDrop.registerDropHandler", _dotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("novoDragDrop.unregisterDropHandler");
            _dotNetRef.Dispose();
        }
    }

    [JSInvokable]
    public async Task OnEscapePressed()
    {
        if (_editingTaskName != null)
        {
            _editingTaskName = null;
            StateHasChanged();
            return;
        }
        if (!string.IsNullOrEmpty(HighlightedTaskName))
        {
            await OnHighlightChanged.InvokeAsync(null);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnDropTask(string targetTaskName, string workerName, string? sourceTask)
    {
        if (Planning == null) return;

        // Absent workers can only be dragged to unplanned, not to tasks
        if (sourceTask == WellKnownIds.AbsentDropZone)
        {
            await JSRuntime.InvokeVoidAsync("novoDragDrop.flashReject", targetTaskName);
            return;
        }

        var person = AllPersons.FirstOrDefault(p => p.Name == workerName);
        var skillLevel = ResolveSkillLevel(person, targetTaskName);

        // Reject if already assigned to this task
        if (Planning.Assignments.Any(a => a.TaskName == targetTaskName && a.WorkerName == workerName))
        {
            await JSRuntime.InvokeVoidAsync("novoDragDrop.flashReject", targetTaskName);
            return;
        }

        // Zeelandia is an overlay task: dropping onto Zeelandia never removes other assignments.
        // Dragging from Zeelandia to another task is blocked if already assigned to a regular/custom task.
        if (sourceTask == ZeelandiaTaskName && targetTaskName != ZeelandiaTaskName
            && Planning.Assignments.Any(a => a.WorkerName == workerName && a.TaskName != ZeelandiaTaskName))
        {
            await JSRuntime.InvokeVoidAsync("novoDragDrop.flashReject", targetTaskName);
            return;
        }

        SaveUndoSnapshot();

        Planning.AbsentWorkers.Remove(workerName);

        if (targetTaskName != ZeelandiaTaskName && !string.IsNullOrEmpty(sourceTask))
        {
            Planning.Assignments.RemoveAll(a => a.TaskName == sourceTask && a.WorkerName == workerName);
        }

        Planning.Assignments.Add(new PlanningAssignment
        {
            TaskName = targetTaskName,
            WorkerName = workerName,
            SkillLevel = skillLevel
        });

        await OnAssignmentChanged.InvokeAsync();
        await JSRuntime.InvokeVoidAsync("novoDragDrop.flashSuccess", targetTaskName);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDropColumnOnTask(string draggedColumnName, string targetTaskName)
    {
        await HandleColumnDrop(draggedColumnName, targetTaskName);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDropUnassigned(string workerName, string? sourceTask)
    {
        if (Planning == null) return;

        SaveUndoSnapshot();

        if (!string.IsNullOrEmpty(sourceTask) && sourceTask != WellKnownIds.AbsentDropZone)
        {
            Planning.Assignments.RemoveAll(a => a.TaskName == sourceTask && a.WorkerName == workerName);
        }

        Planning.AbsentWorkers.Remove(workerName);

        await OnAssignmentChanged.InvokeAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDropAbsent(string workerName, string? sourceTask)
    {
        if (Planning == null) return;

        // Temp workers cannot be marked absent
        var person = AllPersons.FirstOrDefault(p => p.Name == workerName);
        if (person?.IsTempWorker == true)
        {
            await JSRuntime.InvokeVoidAsync("novoDragDrop.flashReject", WellKnownIds.AbsentDropZone);
            return;
        }

        SaveUndoSnapshot();

        Planning.Assignments.RemoveAll(a => a.WorkerName == workerName);

        if (!Planning.AbsentWorkers.Contains(workerName))
        {
            Planning.AbsentWorkers.Add(workerName);
        }

        await OnAssignmentChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task RemoveWorkerFromTask(string taskName, string workerName)
    {
        if (Planning == null) return;
        SaveUndoSnapshot();
        Planning.Assignments.RemoveAll(a => a.TaskName == taskName && a.WorkerName == workerName);
        await OnAssignmentChanged.InvokeAsync();
    }

    private SkillLevel ResolveSkillLevel(Person? person, string taskName)
    {
        var isCustomTask = Planning?.CustomTasks.Any(ct => ct.TaskName == taskName) ?? false;
        var isZeelandia = taskName == ZeelandiaTaskName;
        var skillLevel = isCustomTask || isZeelandia ? SkillLevel.Expert : SkillLevel.Cannot;
        if (person != null && person.Skills.TryGetValue(taskName, out var sl))
            skillLevel = sl;
        return skillLevel;
    }

    private async Task ClearHighlight()
    {
        _editingTaskName = null;
        await OnHighlightChanged.InvokeAsync(null);
    }

    private async Task ToggleHighlight(string taskName)
    {
        await OnHighlightChanged.InvokeAsync(HighlightedTaskName == taskName ? null : taskName);
    }

    private record TaskColumnData(TaskDefinition TaskDef, List<PlanningAssignment> Assignments, bool IsCustom);

    private Dictionary<string, List<PlanningAssignment>>? _assignmentsByTask;

    private Dictionary<string, List<PlanningAssignment>> GetAssignmentsByTask()
    {
        return _assignmentsByTask ??= Planning?.Assignments
            .GroupBy(a => a.TaskName)
            .ToDictionary(g => g.Key, g => g.ToList()) ?? [];
    }

    private List<TaskColumnData> GetAllBoardTasks()
    {
        var grouped = GetAssignmentsByTask();
        var regular = AllTasks
            .Where(t => SelectedTaskIds.Contains(t.Id))
            .Select(t => new TaskColumnData(t, grouped.GetValueOrDefault(t.Name, []), false));
        var custom = (Planning?.CustomTasks ?? [])
            .Select(ct => new TaskColumnData(ct.ToTaskDefinition(), grouped.GetValueOrDefault(ct.TaskName, []), true));
        return regular.Concat(custom)
            .OrderBy(e => e.TaskDef.SortOrder)
            .ToList();
    }

    private static bool IsTaskComplete(TaskColumnData entry)
    {
        var td = entry.TaskDef;
        var assigned = entry.Assignments;
        if (assigned.Count < td.HeadcountRequired) return false;

        var counts = assigned.GroupBy(a => a.SkillLevel).ToDictionary(g => g.Key, g => g.Count());
        var experts = counts.GetValueOrDefault(SkillLevel.Expert);
        var experienced = counts.GetValueOrDefault(SkillLevel.Experienced);
        var beginners = counts.GetValueOrDefault(SkillLevel.Beginner);

        if (td.MinWorkersLevel1 > 0 && experts < td.MinWorkersLevel1) return false;
        if (td.MinWorkersLevel2 > 0 && experts + experienced < td.MinWorkersLevel2) return false;
        if (td.MinWorkersLevel3 > 0 && experts + experienced + beginners < td.MinWorkersLevel3) return false;

        return true;
    }

    private async Task HandleColumnDrop(string draggedName, string targetName)
    {
        if (draggedName == targetName || Planning == null) return;

        // Build unified ordered list of all board task defs (regular + custom)
        var regularDefs = AllTasks
            .Where(t => SelectedTaskIds.Contains(t.Id))
            .ToList();
        var customDefs = Planning.CustomTasks
            .Select(ct => ct.ToTaskDefinition())
            .ToList();
        var allDefs = regularDefs.Concat(customDefs).OrderBy(t => t.SortOrder).ToList();

        var dragged = allDefs.FirstOrDefault(t => t.Name == draggedName);
        var target = allDefs.FirstOrDefault(t => t.Name == targetName);
        if (dragged == null || target == null) return;

        var siblings = allDefs.Where(t => t.Name != draggedName).ToList();
        var targetIndex = siblings.IndexOf(target);
        siblings.Insert(targetIndex, dragged);

        for (var i = 0; i < siblings.Count; i++)
        {
            if (siblings[i].SortOrder != i)
            {
                siblings[i].SortOrder = i;
                var ct = Planning.CustomTasks.FirstOrDefault(c => c.TaskName == siblings[i].Name);
                if (ct != null)
                    ct.SortOrder = i;
                else
                    await OnTaskMoved.InvokeAsync(siblings[i]);
            }
        }

        await OnAssignmentChanged.InvokeAsync();
    }

    // Confirmation wrappers (#8)
    private async Task ConfirmMoveAllToAbsent()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Alle niet-ingeplande medewerkers als afwezig markeren?");
        if (!confirmed) return;
        await MoveAllToAbsent();
    }

    private async Task ConfirmRemoveTaskFromBoard(string taskName)
    {
        if (Planning?.Assignments.Any(a => a.TaskName == taskName) == true)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Taak '{taskName}' van het bord verwijderen? Toegewezen medewerkers worden losgemaakt.");
            if (!confirmed) return;
        }
        await RemoveTaskFromBoard(taskName);
    }

    private async Task ConfirmRemoveCustomTask(string taskName)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Aangepaste taak '{taskName}' verwijderen?");
        if (!confirmed) return;
        await RemoveCustomTask(taskName);
    }

    private async Task MoveAllToAbsent()
    {
        if (Planning == null) return;
        SaveUndoSnapshot();
        var assignedWorkers = Planning.Assignments
            .Select(a => a.WorkerName).ToHashSet();
        var unplanned = AllPersons
            .Where(p => !p.IsTempWorker
                && p.Id != WellKnownIds.TempWorkerTemplateId
                && !assignedWorkers.Contains(p.Name)
                && !Planning.AbsentWorkers.Contains(p.Name))
            .Select(p => p.Name)
            .ToList();

        foreach (var name in unplanned)
        {
            Planning.AbsentWorkers.Add(name);
        }
        await OnAssignmentChanged.InvokeAsync();
    }

    private async Task MoveAllToUnplanned()
    {
        if (Planning == null) return;
        SaveUndoSnapshot();
        Planning.AbsentWorkers.RemoveAll(name => !DayOffWorkerNames.Contains(name));
        await OnAssignmentChanged.InvokeAsync();
    }

    private async Task RemoveTaskFromBoard(string taskName)
    {
        if (Planning != null)
        {
            SaveUndoSnapshot();
            Planning.Assignments.RemoveAll(a => a.TaskName == taskName);
        }

        if (HighlightedTaskName == taskName)
            await OnHighlightChanged.InvokeAsync(null);

        var task = AllTasks.FirstOrDefault(t => t.Name == taskName);
        if (task != null)
        {
            await OnTaskRemoved.InvokeAsync(task.Id);
        }
    }

    private async Task AddCustomTask()
    {
        var name = _newCustomTaskName.Trim();
        if (string.IsNullOrWhiteSpace(name) || Planning == null) return;
        if (Planning.CustomTasks.Any(ct => ct.TaskName.Equals(name, StringComparison.OrdinalIgnoreCase))
            || AllTasks.Any(t => t.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            await JSRuntime.InvokeVoidAsync("alert", $"De taaknaam '{name}' bestaat al.");
            return;
        }

        var maxSort = AllTasks
            .Where(t => SelectedTaskIds.Contains(t.Id))
            .Select(t => t.SortOrder)
            .Concat(Planning.CustomTasks.Select(ct => ct.SortOrder))
            .DefaultIfEmpty(-1)
            .Max();

        Planning.CustomTasks.Add(new CustomTask
        {
            TaskName = name,
            HeadcountRequired = Math.Max(1, _newCustomTaskHeadcount),
            SortOrder = maxSort + 1
        });
        _newCustomTaskName = "";
        _newCustomTaskHeadcount = 2;
        await OnAssignmentChanged.InvokeAsync();
        await OnHighlightChanged.InvokeAsync(name);
    }

    private async Task RemoveCustomTask(string taskName)
    {
        if (Planning == null) return;
        SaveUndoSnapshot();
        Planning.CustomTasks.RemoveAll(ct => ct.TaskName == taskName);
        Planning.Assignments.RemoveAll(a => a.TaskName == taskName);

        if (HighlightedTaskName == taskName)
            await OnHighlightChanged.InvokeAsync(null);

        await OnAssignmentChanged.InvokeAsync();
    }

    private async Task HandleCustomTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddCustomTask();
        }
    }

    // Bulk: clear all workers from a task (#13)
    private async Task ClearAllFromTask(string taskName)
    {
        if (Planning == null) return;
        var count = Planning.Assignments.Count(a => a.TaskName == taskName);
        if (count == 0) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Alle {count} medewerkers loskoppelen van '{taskName}'?");
        if (!confirmed) return;

        SaveUndoSnapshot();
        Planning.Assignments.RemoveAll(a => a.TaskName == taskName);
        await OnAssignmentChanged.InvokeAsync();
    }

    private async Task HandleTaskEdited(TaskDefinition editedDef)
    {
        if (Planning == null) return;

        var customTask = Planning.CustomTasks.FirstOrDefault(ct => ct.TaskName == editedDef.Name);
        if (customTask != null)
        {
            customTask.HeadcountRequired = editedDef.HeadcountRequired;
            customTask.MinWorkersLevel1 = editedDef.MinWorkersLevel1;
            customTask.MinWorkersLevel2 = editedDef.MinWorkersLevel2;
            customTask.MinWorkersLevel3 = editedDef.MinWorkersLevel3;
        }

        await OnTaskEdited.InvokeAsync(editedDef);
    }

    private async Task SetDivider(string taskName, bool value)
    {
        var ct = Planning?.CustomTasks.FirstOrDefault(c => c.TaskName == taskName);
        if (ct != null)
        {
            ct.DividerAbove = value;
            await OnAssignmentChanged.InvokeAsync();
            return;
        }
        var task = AllTasks.FirstOrDefault(t => t.Name == taskName);
        if (task == null) return;
        task.DividerAbove = value;
        await OnTaskMoved.InvokeAsync(task);
    }

    private async Task AssignWorkerToHighlightedTask(string workerName)
    {
        if (Planning == null || string.IsNullOrEmpty(HighlightedTaskName)) return;

        var person = AllPersons.FirstOrDefault(p => p.Name == workerName);
        if (person == null) return;

        var skillLevel = ResolveSkillLevel(person, HighlightedTaskName);

        if (Planning.Assignments.Any(a => a.TaskName == HighlightedTaskName && a.WorkerName == workerName))
            return;

        SaveUndoSnapshot();

        // Remove from current non-Zeelandia task (same as drag behavior)
        if (HighlightedTaskName != ZeelandiaTaskName)
            Planning.Assignments.RemoveAll(a => a.WorkerName == workerName && a.TaskName != ZeelandiaTaskName);

        Planning.Assignments.Add(new PlanningAssignment
        {
            TaskName = HighlightedTaskName,
            WorkerName = workerName,
            SkillLevel = skillLevel
        });

        await OnAssignmentChanged.InvokeAsync();
        await JSRuntime.InvokeVoidAsync("novoDragDrop.flashSuccess", HighlightedTaskName);
        StateHasChanged();
    }
}
