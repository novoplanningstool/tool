@if (Planning != null)
{
    var assignedWorkers = Planning.Assignments
        .Where(a => a.TaskName != WellKnownIds.ZeelandiaTaskName)
        .Select(a => a.WorkerName).ToHashSet();
    var unassigned = AllPersons
        .Where(p => !p.IsTempWorker && p.Id != WellKnownIds.TempWorkerTemplateId && !assignedWorkers.Contains(p.Name) && !Planning.AbsentWorkers.Contains(p.Name))
        .ToList();
    var unassignedTemp = TempWorkers
        .Where(p => !assignedWorkers.Contains(p.Name))
        .ToList();

    <div class="card mt-3 drop-zone" data-drop-zone="unassigned">
        <div class="card-header py-1 d-flex justify-content-between align-items-center" style="background-color: #6c757d; color: white;">
            <div>
                <strong>Niet ingepland</strong>
                <span class="badge bg-light text-dark ms-1">@unassigned.Count</span>
            </div>
            @if (unassigned.Count > 0 && OnMoveAllToAbsent.HasDelegate)
            {
                <button class="btn btn-sm text-white py-0 px-1" style="font-size: 0.75rem; opacity: 0.85; border: 1px solid rgba(255,255,255,0.5);"
                        @onclick="OnMoveAllToAbsent" title="Allemaal naar afwezig">Iedereen afwezig</button>
            }
        </div>
        <div class="card-body p-2" style="min-height: 40px;">
            @foreach (var person in unassigned)
            {
                <span class="badge @GetBadgeClass(person) me-1 mb-1"
                      draggable="true"
                      data-drag-worker="@person.Name"
                      data-drag-source=""
                      @ondblclick="() => OnWorkerDoubleClick.InvokeAsync(person.Name)"
                      @ondblclick:stopPropagation="true"
                      style="cursor: grab; font-size: 0.85rem;">
                    @if (person.SpeaksPolish) {<span class="fi fi-pl flag-icon"></span>}
                    @person.Name
                </span>
            }
        </div>
    </div>

    @if (TempWorkers.Count > 0)
    {
        <div class="card mt-2 drop-zone" data-drop-zone="unassigned">
            <div class="card-header py-1" style="background-color: #e67e22; color: white;">
                <strong>Uitzendkrachten</strong>
                <span class="badge bg-light text-dark ms-1">@unassignedTemp.Count / @TempWorkers.Count</span>
            </div>
            <div class="card-body p-2" style="min-height: 40px;">
                @foreach (var person in unassignedTemp)
                {
                    @if (_editingTempWorkerName == person.Name)
                    {
                        <span class="badge bg-light text-dark me-1 mb-1 d-inline-flex align-items-center" style="font-size: 0.85rem;">
                            <input type="text" class="form-control form-control-sm p-0 border-0"
                                   style="width: 120px; font-size: 0.8rem; background: transparent;"
                                   @bind="_editName"
                                   @bind:event="oninput"
                                   @onkeydown="HandleTempEditKeyDown"
                                   @onblur="CommitTempRename" />
                        </span>
                    }
                    else
                    {
                        <span class="badge @GetBadgeClass(person) me-1 mb-1"
                              draggable="true"
                              data-drag-worker="@person.Name"
                              data-drag-source=""
                              @ondblclick="() => OnWorkerDoubleClick.InvokeAsync(person.Name)"
                              @ondblclick:stopPropagation="true"
                              style="cursor: grab; font-size: 0.85rem;">
                            @if (person.SpeaksPolish) {<span class="fi fi-pl flag-icon"></span>}
                            @person.Name
                            @if (OnTempWorkerRenamed.HasDelegate)
                            {
                                <span @onclick="() => StartTempEditing(person.Name)" @onclick:stopPropagation="true"
                                      title="Naam wijzigen" style="cursor: pointer; margin-left: 4px; opacity: 0.7;">&#9998;</span>
                            }
                        </span>
                    }
                }
            </div>
        </div>
    }

    <div class="card mt-2 drop-zone" data-drop-zone="absent">
        <div class="card-header py-1 d-flex justify-content-between align-items-center" style="background-color: #a0522d; color: white;">
            <div>
                <strong>Afwezig</strong>
                <span class="badge bg-light text-dark ms-1">@Planning.AbsentWorkers.Count</span>
            </div>
            @if (Planning.AbsentWorkers.Count > 0 && OnMoveAllToUnplanned.HasDelegate)
            {
                <button class="btn btn-sm text-white py-0 px-1" style="font-size: 0.75rem; opacity: 0.85; border: 1px solid rgba(255,255,255,0.5);"
                        @onclick="OnMoveAllToUnplanned" title="Allemaal beschikbaar (behalve vrije dagen)">Iedereen beschikbaar</button>
            }
        </div>
        <div class="card-body p-2" style="min-height: 40px;">
            @foreach (var name in Planning.AbsentWorkers)
            {
                var person = AllPersons.FirstOrDefault(p => p.Name == name);
                <span class="badge @GetAbsentBadgeClass(person) me-1 mb-1"
                      draggable="true"
                      data-drag-worker="@name"
                      data-drag-source="@WellKnownIds.AbsentDropZone"
                      style="cursor: grab; font-size: 0.8rem;">
                    @if (person?.SpeaksPolish == true) {<span class="fi fi-pl flag-icon"></span>}
                    @name
                </span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public PlanningModel? Planning { get; set; }
    [Parameter] public List<Person> AllPersons { get; set; } = [];
    [Parameter] public List<Person> TempWorkers { get; set; } = [];
    [Parameter] public EventCallback OnMoveAllToAbsent { get; set; }
    [Parameter] public EventCallback OnMoveAllToUnplanned { get; set; }
    [Parameter] public string? HighlightedTaskName { get; set; }
    [Parameter] public EventCallback<string> OnWorkerDoubleClick { get; set; }
    [Parameter] public EventCallback<(string OldName, string NewName)> OnTempWorkerRenamed { get; set; }

    private string? _editingTempWorkerName;
    private string _editName = "";

    private void StartTempEditing(string name)
    {
        _editingTempWorkerName = name;
        _editName = name;
    }

    private async Task HandleTempEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitTempRename();
        else if (e.Key == "Escape") _editingTempWorkerName = null;
    }

    private async Task CommitTempRename()
    {
        var oldName = _editingTempWorkerName;
        _editingTempWorkerName = null;
        var newName = _editName.Trim();
        if (!string.IsNullOrEmpty(oldName) && !string.IsNullOrEmpty(newName) && newName != oldName)
        {
            await OnTempWorkerRenamed.InvokeAsync((oldName, newName));
        }
    }

    private SkillLevel GetSkillForTask(Person person)
    {
        if (string.IsNullOrEmpty(HighlightedTaskName))
            return SkillLevel.Cannot;

        // If person has an explicit skill entry, use it; otherwise treat as Expert
        // (tasks from Excel always have skill entries; missing = custom/Zeelandia = everyone can do it)
        return person.Skills.TryGetValue(HighlightedTaskName, out var sl) ? sl : SkillLevel.Expert;
    }

    private string GetBadgeClass(Person person)
    {
        if (string.IsNullOrEmpty(HighlightedTaskName))
            return "bg-secondary text-white";

        return GetSkillForTask(person) switch
        {
            SkillLevel.Expert => "bg-success text-white",
            SkillLevel.Experienced => "bg-info text-dark",
            SkillLevel.Beginner => "bg-warning text-dark",
            SkillLevel.Cannot => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    private string GetAbsentBadgeClass(Person? person)
    {
        return "bg-light text-dark border";
    }
}
